---
import '@fontsource-variable/nunito';
import '@fontsource-variable/lora';
import '@/styles/global.css';
import { SITE } from '@/config/site';

/**
 * ANACAN SEO PANEL — internal dashboard (noindex, robots-disallowed).
 * Renders /seo-report.json produced by `npm run seo:audit`
 * (methodology-compatible with the claude-seo skill).
 */
const siteUrl = (Astro.site ?? new URL(SITE.url)).href.replace(/\/$/, '');
---

<!doctype html>
<html lang="az" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SEO Panel — Anacan</title>
    <meta name="description" content="Anacan saytının daxili SEO idarə paneli." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body>
    <header class="site-header scrolled">
      <div class="container header-inner">
        <a href="/" class="brand"><img src="/icon-192.png" alt="" width="38" height="38" style="border-radius:11px" /> <span>Anacan <em style="font-style:normal;color:var(--coral)">SEO</em></span></a>
        <div class="header-actions">
          <a class="btn btn-ghost btn-sm" href="/seo-report.json" download="anacan-seo-report.json">JSON hesabat</a>
          <a class="btn btn-ghost btn-sm" href="/SEO-REPORT.md" download="ANACAN-SEO-REPORT.md">MD hesabat</a>
          <a class="btn btn-primary btn-sm" href="/">Sayta qayıt</a>
        </div>
      </div>
    </header>

    <main class="container" style="padding-block:2.5rem 5rem" data-site={siteUrl}>
      <div id="panel-empty" class="info-card" style="max-width:720px;margin-inline:auto;display:none">
        <span class="i-ico">📊</span>
        <h3>Hesabat tapılmadı</h3>
        <p>
          SEO hesabatı hələ yaradılmayıb. Terminalda bu əmrləri işlədin:
        </p>
        <pre style="background:var(--bg-soft);padding:1rem 1.2rem;border-radius:14px;overflow-x:auto;font-size:.9rem"><code>npm run build      # sayt + audit birlikdə
# və ya ayrıca:
npm run seo:audit  # mövcud dist/ üzərində</code></pre>
      </div>

      <div id="panel" style="display:none">
        <!-- score hero -->
        <section class="panel-hero">
          <div class="score-ring" id="score-ring" role="img" aria-label="SEO Health Score">
            <svg viewBox="0 0 120 120" width="168" height="168">
              <circle cx="60" cy="60" r="52" fill="none" stroke="#ffe3d8" stroke-width="11"></circle>
              <circle id="ring-val" cx="60" cy="60" r="52" fill="none" stroke="url(#ring-grad)" stroke-width="11" stroke-linecap="round" stroke-dasharray="326.7" stroke-dashoffset="326.7" transform="rotate(-90 60 60)"></circle>
              <defs>
                <linearGradient id="ring-grad" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#ff8d89"></stop>
                  <stop offset="100%" stop-color="#e8474d"></stop>
                </linearGradient>
              </defs>
            </svg>
            <div class="score-num"><b id="score-val">–</b><span>/100</span><em id="score-grade"></em></div>
          </div>
          <div class="panel-hero-copy">
            <span class="eyebrow">SEO Health Score · claude-seo metodologiyası</span>
            <h1 style="font-size:clamp(1.8rem,4vw,2.6rem)">Anacan SEO Paneli</h1>
            <p class="lede" style="font-size:1.05rem">
              Statik audit <code id="meta-site"></code> üçün <b id="meta-pages"></b> səhifəni,
              <b id="meta-langs"></b> dili və <b id="meta-checks"></b> yoxlamanı əhatə edir.
              Kateqoriya çəkiləri claude-seo ilə eynidir (Technical 22% · Content 23% · On-Page 20% · Schema 10% · Performance 10% · AI 10% · Images 5%).
            </p>
            <p class="hero-note">Yaradılıb: <span id="meta-date"></span> · Yeniləmək üçün: <code>npm run seo:audit</code></p>
            <div class="status-pills">
              <span class="pill pass">✓ <b id="n-pass">0</b> keçdi</span>
              <span class="pill warn">! <b id="n-warn">0</b> xəbərdarlıq</span>
              <span class="pill fail">✗ <b id="n-fail">0</b> uğursuz</span>
            </div>
          </div>
        </section>

        <!-- category bars -->
        <section class="mt-4">
          <div id="cat-bars" class="cat-grid"></div>
        </section>

        <!-- tabs -->
        <nav class="panel-tabs" role="tablist" aria-label="Panel bölmələri">
          <button data-tab="priorities" aria-selected="true">Prioritetlər</button>
          <button data-tab="checks" aria-selected="false">Yoxlamalar</button>
          <button data-tab="pages" aria-selected="false">Səhifələr</button>
          <button data-tab="hreflang" aria-selected="false">Hreflang matrisi</button>
          <button data-tab="claude" aria-selected="false">claude-seo</button>
        </nav>

        <section id="tab-priorities" class="tab-panel" data-open="true"></section>
        <section id="tab-checks" class="tab-panel"></section>
        <section id="tab-pages" class="tab-panel">
          <div class="pages-toolbar">
            <input id="page-search" type="search" placeholder="Yol üzrə axtar… (/en/blog/…)" />
            <select id="page-lang"><option value="">Bütün dillər</option></select>
            <label><input type="checkbox" id="page-issues" /> Yalnız problemlilər</label>
          </div>
          <div style="overflow-x:auto"><table class="panel-table" id="pages-table">
            <thead><tr><th>Səhifə</th><th>Dil</th><th>Title</th><th>Desc</th><th>Söz</th><th>JS</th><th>Schema</th><th>Problemlər</th></tr></thead>
            <tbody></tbody>
          </table></div>
        </section>
        <section id="tab-hreflang" class="tab-panel"></section>
        <section id="tab-claude" class="tab-panel"></section>
      </div>
    </main>

    <script>
      const $ = (sel: string, el: ParentNode = document) => el.querySelector(sel) as HTMLElement;
      const $$ = (sel: string, el: ParentNode = document) => [...el.querySelectorAll(sel)] as HTMLElement[];
      const esc = (s: unknown) =>
        String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] as string);

      const STATUS = { pass: ['pass', '✓'], warn: ['warn', '!'], fail: ['fail', '✗'] } as Record<string, string[]>;
      const LEVELS = ['Critical', 'High', 'Medium', 'Low'];
      const LEVEL_AZ: Record<string, string> = { Critical: 'Kritik', High: 'Yüksək', Medium: 'Orta', Low: 'Aşağı' };

      async function boot() {
        let report: any = null;
        try {
          const res = await fetch('/seo-report.json', { cache: 'no-store' });
          if (res.ok) report = await res.json();
        } catch {}
        if (!report) {
          $('#panel-empty').style.display = 'grid';
          return;
        }
        $('#panel').style.display = 'block';
        render(report);
      }

      function render(r: any) {
        /* hero */
        $('#score-val').textContent = r.score;
        $('#score-grade').textContent = r.grade;
        $('#meta-site').textContent = r.site;
        $('#meta-pages').textContent = r.totals.pages;
        $('#meta-langs').textContent = r.totals.languages.length;
        $('#meta-checks').textContent = r.totals.checks;
        $('#meta-date').textContent = new Date(r.generatedAt).toLocaleString('az-Latn-AZ');
        $('#n-pass').textContent = r.totals.passed;
        $('#n-warn').textContent = r.totals.warnings;
        $('#n-fail').textContent = r.totals.failed;
        const ring = $('#ring-val');
        const C = 326.7;
        requestAnimationFrame(() => {
          ring.style.transition = 'stroke-dashoffset 1.1s cubic-bezier(.2,.6,.2,1)';
          ring.setAttribute('stroke-dashoffset', String(C - (C * r.score) / 100));
        });

        /* category bars */
        $('#cat-bars').innerHTML = r.categories
          .map(
            (c: any) => `
          <div class="cat-card">
            <div class="cat-top"><b>${esc(c.label)}</b><span class="cat-w">${c.weight}%</span></div>
            <div class="cat-score">${c.score}<span>/100</span></div>
            <div class="cat-bar"><i style="width:${c.score}%" data-level="${c.score >= 85 ? 'good' : c.score >= 65 ? 'mid' : 'low'}"></i></div>
            <div class="cat-note">${c.checks.filter((x: any) => x.status === 'pass').length}/${c.checks.length} yoxlama keçdi</div>
          </div>`,
          )
          .join('');

        /* priorities */
        const pr = $('#tab-priorities');
        if (r.priorities.length === 0) {
          pr.innerHTML = `<div class="info-card" style="max-width:640px"><span class="i-ico">🎉</span><h3>Açıq tapıntı yoxdur</h3><p>Bütün yoxlamalar keçib. Deploy-dan sonra tam crawl üçün <code>/seo audit ${esc(r.site)}</code> işlədin.</p></div>`;
        } else {
          pr.innerHTML = LEVELS.filter((l) => r.priorities.some((p: any) => p.level === l))
            .map(
              (level) => `
            <h2 class="prio-h" data-level="${level}">${LEVEL_AZ[level]} <span>${r.priorities.filter((p: any) => p.level === level).length}</span></h2>
            <div class="prio-list">
              ${r.priorities
                .filter((p: any) => p.level === level)
                .map(
                  (p: any) => `
                <details class="prio-card" data-level="${level}">
                  <summary><b>${esc(p.title)}</b><span>${esc(p.detail)}</span></summary>
                  <div class="prio-body">
                    <p><b>Tövsiyə:</b> ${esc(p.recommendation)}</p>
                    <p><b>Falsifiability:</b> ${esc(p.falsifiability)}</p>
                    <p><b>Leading indicator:</b> ${esc(p.leadingIndicator)}</p>
                    ${p.pages?.length ? `<p><b>Səhifələr:</b> ${p.pages.slice(0, 12).map((x: string) => `<code>${esc(x)}</code>`).join(' ')}</p>` : ''}
                  </div>
                </details>`,
                )
                .join('')}
            </div>`,
            )
            .join('');
        }

        /* checks */
        $('#tab-checks').innerHTML = r.categories
          .map(
            (c: any) => `
          <h2 class="prio-h">${esc(c.label)} <span>${c.score}/100</span></h2>
          <div class="prio-list">
            ${c.checks
              .map((ch: any) => {
                const [cls, icon] = STATUS[ch.status];
                return `
              <details class="prio-card">
                <summary><i class="st ${cls}">${icon}</i><b>${esc(ch.label)}</b><span>${esc(ch.details)}</span></summary>
                ${ch.pages?.length ? `<div class="prio-body"><p>${ch.pages.map((x: string) => `<code>${esc(x)}</code>`).join(' ')}</p></div>` : '<div class="prio-body"><p>Bütün səhifələr üçün keçərlidir.</p></div>'}
              </details>`;
              })
              .join('')}
          </div>`,
          )
          .join('');

        /* pages table */
        const langSel = $('#page-lang') as HTMLSelectElement;
        for (const l of r.totals.languages) {
          const o = document.createElement('option');
          o.value = l;
          o.textContent = l;
          langSel.appendChild(o);
        }
        const tbody = $('#pages-table tbody');
        const drawPages = () => {
          const q = ($('#page-search') as HTMLInputElement).value.toLowerCase();
          const lang = langSel.value;
          const onlyIssues = ($('#page-issues') as HTMLInputElement).checked;
          tbody.innerHTML = r.pages
            .filter(
              (p: any) =>
                (!q || p.path.toLowerCase().includes(q) || (p.title || '').toLowerCase().includes(q)) &&
                (!lang || p.lang === lang) &&
                (!onlyIssues || p.issues.length > 0),
            )
            .map(
              (p: any) => `
            <tr>
              <td><a href="${esc(p.path)}" target="_blank" rel="noopener"><code>${esc(p.path)}</code></a></td>
              <td>${esc(p.lang)}</td>
              <td class="${p.titleLength >= 25 && p.titleLength <= 65 ? 'ok' : 'bad'}">${p.titleLength}</td>
              <td class="${p.metaDescLength >= 70 && p.metaDescLength <= 165 ? 'ok' : 'bad'}">${p.metaDescLength}</td>
              <td>${p.wordCount}</td>
              <td>${(p.jsBytes / 1024).toFixed(0)}KB</td>
              <td>${p.ldTypes.slice(0, 3).map((t: string) => `<small>${esc(t)}</small>`).join(' ')}</td>
              <td>${p.issues.length ? `<span class="pill fail">${p.issues.length}</span> <small>${p.issues.slice(0, 3).join(', ')}</small>` : '<span class="pill pass">✓</span>'}</td>
            </tr>`,
            )
            .join('');
        };
        drawPages();
        $('#page-search').addEventListener('input', drawPages);
        langSel.addEventListener('change', drawPages);
        $('#page-issues').addEventListener('change', drawPages);

        /* hreflang matrix: group by path stripped of lang prefix */
        const langs: string[] = r.totals.languages;
        const groups = new Map<string, Record<string, string>>();
        for (const p of r.pages) {
          let key = p.path;
          for (const l of langs) {
            if (key === `/${l}/` ) key = '/';
            else if (key.startsWith(`/${l}/`)) key = key.slice(l.length + 1);
          }
          if (p.isBlogPost) key = `[bloq] ${p.title.slice(0, 44)}`;
          const g = groups.get(key) ?? {};
          g[p.lang] = p.path;
          groups.set(key, g);
        }
        $('#tab-hreflang').innerHTML = `
          <p class="lede" style="font-size:1rem;margin-bottom:1rem">Hər sətir bir məzmun vahididir — hansı dillərdə mövcud olduğunu göstərir. Bloq postları translationKey üzrə qruplaşdırılıb.</p>
          <div style="overflow-x:auto"><table class="panel-table">
            <thead><tr><th>Məzmun</th>${langs.map((l) => `<th style="text-align:center">${l}</th>`).join('')}</tr></thead>
            <tbody>
              ${[...groups.entries()]
                .sort((a, b) => a[0].localeCompare(b[0]))
                .map(
                  ([key, g]) => `
                <tr>
                  <td><code>${esc(key)}</code></td>
                  ${langs
                    .map((l) =>
                      g[l]
                        ? `<td style="text-align:center"><a class="pill pass" href="${esc(g[l])}" target="_blank" rel="noopener">✓</a></td>`
                        : `<td style="text-align:center"><span class="pill fail">—</span></td>`,
                    )
                    .join('')}
                </tr>`,
                )
                .join('')}
            </tbody>
          </table></div>`;

        /* claude-seo bridge */
        const site = r.site;
        $('#tab-claude').innerHTML = `
          <div class="claude-grid">
            <div class="info-card">
              <span class="i-ico">🧠</span>
              <h3>claude-seo ilə tam audit</h3>
              <p>Bu panel claude-seo skillinin çəkilərini və keyfiyyət qaydalarını statik səviyyədə tətbiq edir. Deploy-dan sonra Claude Code-da tam crawl-əsaslı audit üçün:</p>
              <pre><code>/seo audit ${esc(site)}
/seo page ${esc(site)}/en/
/seo schema ${esc(site)}
/seo geo ${esc(site)}
/seo hreflang ${esc(site)}
/seo sitemap ${esc(site)}/sitemap.xml
/seo content ${esc(site)}/blog/
/seo drift baseline ${esc(site)}</code></pre>
              <p><small>Quraşdırma: <code>/plugin marketplace add AgriciDaniel/claude-seo</code> → <code>/plugin install claude-seo@agricidaniel-claude-seo</code> → <code>/seo setup</code></small></p>
            </div>
            <div class="info-card">
              <span class="i-ico">🧩</span>
              <h3>Metodologiya uyğunluğu</h3>
              <p>${(r.methodology?.notes ?? []).map((n: string) => `• ${esc(n)}`).join('<br/>')}</p>
              <p><b>Çəkilər:</b> ${Object.entries(r.methodology?.weights ?? {})
                .map(([k, v]) => `${esc(k)} ${v}%`)
                .join(' · ')}</p>
            </div>
            <div class="info-card">
              <span class="i-ico">🔗</span>
              <h3>SEO artefaktları</h3>
              <p>
                <a class="link" href="/sitemap.xml" target="_blank">sitemap.xml</a> ·
                <a class="link" href="/robots.txt" target="_blank">robots.txt</a> ·
                <a class="link" href="/llms.txt" target="_blank">llms.txt</a> ·
                <a class="link" href="/llms-full.txt" target="_blank">llms-full.txt</a> ·
                <a class="link" href="/rss.xml" target="_blank">rss.xml</a> ·
                <a class="link" href="/manifest.webmanifest" target="_blank">manifest</a>
              </p>
              <p>Hesabatlar: <a class="link" href="/seo-report.json" download>seo-report.json</a> · <a class="link" href="/SEO-REPORT.md" download>SEO-REPORT.md</a></p>
            </div>
            <div class="info-card">
              <span class="i-ico">🌍</span>
              <h3>Yeni dil əlavə etmək</h3>
              <p>Tətbiqə yeni dil gələndə saytda da aktivləşdirin:</p>
              <pre><code>npm run add:lang -- uz</code></pre>
              <p><small>Skript i18n lüğətini, bloq qovluğunu və dil reyestrini hazırlayır — routing, sitemap, hreflang, RSS, llms.txt və OG şəkillər avtomatik yaranır.</small></p>
            </div>
          </div>`;

        /* tabs */
        $$('.panel-tabs button').forEach((btn) => {
          btn.addEventListener('click', () => {
            $$('.panel-tabs button').forEach((b) => b.setAttribute('aria-selected', String(b === btn)));
            $$('.tab-panel').forEach((p) => (p as HTMLElement).removeAttribute('data-open'));
            $(`#tab-${btn.dataset.tab}`).setAttribute('data-open', 'true');
          });
        });
      }

      boot();
    </script>

    <style is:global>
      .panel-hero {
        display: grid;
        gap: 2rem;
        align-items: center;
        background: var(--surface);
        border-radius: var(--r-xl);
        box-shadow: var(--shadow-md);
        padding: clamp(1.6rem, 4vw, 2.8rem);
      }

      @media (min-width: 820px) {
        .panel-hero {
          grid-template-columns: auto 1fr;
        }
      }

      .panel-hero-copy {
        display: grid;
        gap: 0.8rem;
        justify-items: start;
      }

      .score-ring {
        position: relative;
        width: 168px;
        height: 168px;
        margin-inline: auto;
      }

      .score-num {
        position: absolute;
        inset: 0;
        display: grid;
        place-content: center;
        justify-items: center;
        line-height: 1;
      }

      .score-num b {
        font-family: var(--font-display);
        font-size: 2.9rem;
        font-weight: 600;
      }

      .score-num span {
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--ink-faint);
      }

      .score-num em {
        font-style: normal;
        font-weight: 900;
        font-size: 0.9rem;
        color: var(--coral);
        margin-top: 0.2rem;
      }

      .status-pills {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
      }

      .pill {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.85rem;
        font-weight: 800;
        border-radius: 999px;
        padding: 0.35rem 0.85rem;
      }

      .pill.pass { background: var(--mommy-soft); color: #17604a; }
      .pill.warn { background: var(--gold-soft); color: #7a5a00; }
      .pill.fail { background: var(--coral-soft); color: var(--coral-ink); }

      .cat-grid {
        display: grid;
        gap: 0.9rem;
        grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
      }

      .cat-card {
        background: var(--surface);
        border-radius: var(--r-md);
        box-shadow: var(--shadow-sm);
        padding: 1.1rem 1.2rem;
        display: grid;
        gap: 0.45rem;
      }

      .cat-top {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 0.6rem;
        font-size: 0.92rem;
      }

      .cat-w {
        font-size: 0.75rem;
        font-weight: 800;
        color: var(--ink-faint);
      }

      .cat-score {
        font-family: var(--font-display);
        font-size: 1.9rem;
        font-weight: 600;
      }

      .cat-score span {
        font-size: 0.9rem;
        color: var(--ink-faint);
      }

      .cat-bar {
        height: 9px;
        border-radius: 999px;
        background: var(--bg-soft);
        overflow: hidden;
      }

      .cat-bar i {
        display: block;
        height: 100%;
        border-radius: 999px;
        transition: width 0.9s cubic-bezier(0.2, 0.6, 0.2, 1);
      }

      .cat-bar i[data-level='good'] { background: linear-gradient(90deg, #4cc596, var(--mommy)); }
      .cat-bar i[data-level='mid'] { background: linear-gradient(90deg, var(--gold), #f5a623); }
      .cat-bar i[data-level='low'] { background: linear-gradient(90deg, #ff8d89, var(--coral-deep)); }

      .cat-note {
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--ink-faint);
      }

      .panel-tabs {
        display: flex;
        gap: 0.4rem;
        flex-wrap: wrap;
        margin-top: 2.2rem;
        border-bottom: 2px solid #f6e4da;
        padding-bottom: 0.7rem;
      }

      .panel-tabs button {
        font-weight: 800;
        font-size: 0.95rem;
        padding: 0.55rem 1.1rem;
        border-radius: 999px;
        color: var(--ink-soft);
      }

      .panel-tabs button[aria-selected='true'] {
        background: var(--ink);
        color: #fff;
      }

      .tab-panel {
        display: none;
        margin-top: 1.6rem;
      }

      .tab-panel[data-open='true'] {
        display: block;
      }

      .prio-h {
        font-size: 1.15rem;
        font-family: var(--font-body);
        font-weight: 800;
        margin: 1.4rem 0 0.7rem;
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }

      .prio-h span {
        font-size: 0.8rem;
        background: var(--peach);
        color: var(--coral-ink);
        border-radius: 999px;
        padding: 0.2rem 0.7rem;
      }

      .prio-h[data-level='Critical'] span { background: var(--coral); color: #fff; }

      .prio-list {
        display: grid;
        gap: 0.6rem;
      }

      .prio-card {
        background: var(--surface);
        border-radius: var(--r-md);
        box-shadow: var(--shadow-sm);
      }

      .prio-card summary {
        list-style: none;
        cursor: pointer;
        display: flex;
        align-items: baseline;
        gap: 0.7rem;
        padding: 0.9rem 1.15rem;
        flex-wrap: wrap;
      }

      .prio-card summary::-webkit-details-marker { display: none; }

      .prio-card summary b { font-size: 0.97rem; }

      .prio-card summary span {
        font-size: 0.84rem;
        color: var(--ink-faint);
        font-weight: 650;
      }

      .prio-card .st {
        flex: none;
        font-style: normal;
        width: 22px;
        height: 22px;
        border-radius: 8px;
        display: inline-grid;
        place-items: center;
        font-size: 0.75rem;
        font-weight: 900;
        translate: 0 3px;
      }

      .st.pass { background: var(--mommy-soft); color: #17604a; }
      .st.warn { background: var(--gold-soft); color: #7a5a00; }
      .st.fail { background: var(--coral-soft); color: var(--coral-ink); }

      .prio-body {
        padding: 0 1.15rem 1.05rem;
        display: grid;
        gap: 0.45rem;
        font-size: 0.9rem;
        color: var(--ink-soft);
      }

      .prio-body code, .panel-table code {
        background: var(--bg-soft);
        border-radius: 7px;
        padding: 0.1rem 0.45rem;
        font-size: 0.82em;
      }

      .pages-toolbar {
        display: flex;
        gap: 0.7rem;
        flex-wrap: wrap;
        align-items: center;
        margin-bottom: 1rem;
        font-weight: 700;
        font-size: 0.9rem;
      }

      .pages-toolbar input[type='search'],
      .pages-toolbar select {
        font: inherit;
        padding: 0.55rem 0.9rem;
        border-radius: 12px;
        border: 2px solid #f3ddd3;
        background: var(--surface);
        min-width: 220px;
      }

      .panel-table {
        width: 100%;
        border-collapse: collapse;
        background: var(--surface);
        border-radius: var(--r-md);
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        font-size: 0.88rem;
      }

      .panel-table th,
      .panel-table td {
        text-align: left;
        padding: 0.65rem 0.85rem;
        border-bottom: 1px solid #f6e4da;
        vertical-align: top;
      }

      .panel-table thead th {
        background: var(--peach);
        color: var(--coral-ink);
        font-weight: 800;
        white-space: nowrap;
      }

      .panel-table td.ok { color: #17604a; font-weight: 800; }
      .panel-table td.bad { color: var(--coral-deep); font-weight: 800; }
      .panel-table small { color: var(--ink-faint); }

      .claude-grid {
        display: grid;
        gap: 1rem;
      }

      @media (min-width: 900px) {
        .claude-grid {
          grid-template-columns: 1fr 1fr;
        }
      }

      .claude-grid pre {
        background: var(--ink);
        color: #ffd9d3;
        border-radius: 14px;
        padding: 1rem 1.2rem;
        overflow-x: auto;
        font-size: 0.85rem;
        line-height: 1.7;
      }
    </style>
  </body>
</html>
