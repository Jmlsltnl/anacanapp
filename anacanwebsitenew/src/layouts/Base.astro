---
import '@fontsource-variable/nunito';
import '@fontsource-variable/lora';
import '@/styles/global.css';

import { SITE } from '@/config/site';
import { LANGUAGES, getLanguage, DEFAULT_LANG, langPrefix } from '@/config/languages';
import { pagePath, type PageKey } from '@/config/pages';
import { useTranslations } from '@/i18n';
import { organizationLd, websiteLd, appLd, breadcrumbLd, pageAlternates, type BreadcrumbItem } from '@/utils/seo';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface AlternateLink {
  hreflang: string;
  href: string;
  /** language code for the switcher */
  code?: string;
}

interface Props {
  lang: string;
  title: string;
  description: string;
  /** Static page key: drives canonical + hreflang automatically */
  pageKey?: PageKey;
  /** Custom alternates (blog posts) — absolute URLs */
  alternates?: AlternateLink[];
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
  /** Extra JSON-LD nodes merged into the @graph */
  extraLd?: Record<string, unknown>[];
  /** Article meta for og:article */
  article?: { pubDate: Date; updatedDate?: Date; section: string; tags: string[] };
}

const {
  lang,
  title,
  description,
  pageKey,
  alternates,
  ogImage,
  ogType = 'website',
  noindex = false,
  breadcrumbs,
  extraLd = [],
  article,
} = Astro.props;

const site = Astro.site!;
const language = getLanguage(lang);
const t = useTranslations(lang);

/* Canonical: current path, normalized with a trailing slash. */
let path = Astro.url.pathname;
if (!path.endsWith('/')) path += '/';
const canonical = new URL(path, site).href;

/* hreflang set */
const altLinks: AlternateLink[] =
  alternates ??
  (pageKey
    ? pageAlternates(site, pageKey).map((a) => ({ ...a }))
    : [{ hreflang: language.bcp47, href: canonical }]);

/* Language switcher targets (fall back to each language's home). */
const switcherLinks = LANGUAGES.map((l) => {
  const match = altLinks.find((a) => a.code === l.code || a.hreflang === l.bcp47);
  return {
    code: l.code,
    native: l.nativeName,
    flag: l.flag,
    href: match ? new URL(match.href).pathname : pagePath('home', l.code),
    current: l.code === lang,
  };
});

/* OG image (per-language default, per-post override) */
const ogImagePath = ogImage ?? `/og/og-${lang}.png`;
const ogImageUrl = new URL(ogImagePath, site).href;

/* JSON-LD graph */
const graph: Record<string, unknown>[] = [
  organizationLd(site),
  websiteLd(site, lang),
  appLd(site, lang),
  {
    '@type': 'WebPage',
    '@id': canonical,
    url: canonical,
    name: title,
    description,
    inLanguage: language.bcp47,
    isPartOf: { '@id': new URL('/#website', site).href },
    about: { '@id': new URL('/#app', site).href },
    primaryImageOfPage: { '@type': 'ImageObject', url: ogImageUrl, width: SITE.ogWidth, height: SITE.ogHeight },
    ...(breadcrumbs ? { breadcrumb: breadcrumbLd(site, breadcrumbs) } : {}),
  },
  ...extraLd,
];

const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });

const rssTitle = `${SITE.name} Blog`;
---

<!doctype html>
<html lang={lang} dir={language.dir} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
      )
    }

    {/* hreflang alternates */}
    {!noindex && altLinks.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(SITE.ogWidth)} />
    <meta property="og:image:height" content={String(SITE.ogHeight)} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={language.ogLocale} />
    {LANGUAGES.filter((l) => l.code !== lang).map((l) => (
      <meta property="og:locale:alternate" content={l.ogLocale} />
    ))}
    {
      article && (
        <>
          <meta property="article:published_time" content={article.pubDate.toISOString()} />
          <meta property="article:modified_time" content={(article.updatedDate ?? article.pubDate).toISOString()} />
          <meta property="article:section" content={article.section} />
          {article.tags.map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      )
    }

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Icons + PWA */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content={SITE.themeColor} />

    {/* Feeds */}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${rssTitle} (${language.nativeName})`}
      href={new URL(`${langPrefix(lang) || ''}/rss.xml`.replace('//', '/'), site).href}
    />
    {
      lang !== DEFAULT_LANG && (
        <link rel="alternate" type="application/rss+xml" title={rssTitle} href={new URL('/rss.xml', site).href} />
      )
    }

    {/* Structured data */}
    <script type="application/ld+json" set:html={jsonLd} />

    <script>
      document.documentElement.classList.remove('no-js');
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">{t('nav.skipToContent')}</a>
    <Header lang={lang} switcherLinks={switcherLinks} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // ── Header shadow on scroll ─────────────────────────────────────────
      const header = document.querySelector('.site-header');
      if (header) {
        const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 8);
        onScroll();
        addEventListener('scroll', onScroll, { passive: true });
      }

      // ── Language dropdown ───────────────────────────────────────────────
      const langSwitch = document.querySelector<HTMLElement>('.lang-switch');
      const langBtn = langSwitch?.querySelector<HTMLButtonElement>('.lang-btn');
      if (langSwitch && langBtn) {
        langBtn.addEventListener('click', () => {
          const open = langSwitch.dataset.open === 'true';
          langSwitch.dataset.open = String(!open);
          langBtn.setAttribute('aria-expanded', String(!open));
        });
        document.addEventListener('click', (e) => {
          if (!langSwitch.contains(e.target as Node)) {
            langSwitch.dataset.open = 'false';
            langBtn.setAttribute('aria-expanded', 'false');
          }
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            langSwitch.dataset.open = 'false';
            langBtn.setAttribute('aria-expanded', 'false');
          }
        });
      }

      // ── Mobile menu ─────────────────────────────────────────────────────
      const menu = document.querySelector<HTMLElement>('.mobile-menu');
      const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
      const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');
      const setMenu = (open: boolean) => {
        if (!menu) return;
        menu.dataset.open = String(open);
        document.body.style.overflow = open ? 'hidden' : '';
        openBtn?.setAttribute('aria-expanded', String(open));
      };
      openBtn?.addEventListener('click', () => setMenu(true));
      closeBtn?.addEventListener('click', () => setMenu(false));
      menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));

      // ── Reveal on scroll (SEO-safe) ─────────────────────────────────────
      // Content is never trapped hidden: no-JS shows everything (html.no-js),
      // reduced-motion shows everything, and a hard fallback force-reveals
      // anything left after 2.5s (rendering bots, prerender snapshots).
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll('.reveal');
      const revealAll = () => targets.forEach((el) => el.classList.add('in'));
      if (reduced || !('IntersectionObserver' in window)) {
        revealAll();
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('in');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.1, rootMargin: '0px 0px -30px 0px' },
        );
        targets.forEach((el) => io.observe(el));
        setTimeout(revealAll, 2500);
      }
    </script>
  </body>
</html>
