---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import StoreBadges from '@/components/StoreBadges.astro';
import { pagePath } from '@/config/pages';
import { useTranslations } from '@/i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const steps = t<{ title: string; text: string }[]>('downloadPage.steps');
const tools = t<{ name: string; desc: string; stage: string }[]>('tools.items');
const toolEmojis = ['⏱️', '👣', '📅', '🎒', '🌸', '📔', '📈', '😴', '💉', '🍼', '✨', '🧚', '🥗', '💊', '🫶', '⛑️'];

const breadcrumbs = [
  { name: t('breadcrumbs.home'), path: pagePath('home', lang) },
  { name: t('footer.downloadTitle'), path: pagePath('download', lang) },
];
---

<Base
  lang={lang}
  title={t('meta.download.title')}
  description={t('meta.download.description')}
  pageKey="download"
  breadcrumbs={breadcrumbs}
>
  <div class="container">
    <div class="page-hero center" style="justify-items:center;text-align:center;margin-inline:auto;max-width:46em">
      <Breadcrumbs items={breadcrumbs} />
      <span class="eyebrow">{t('downloadPage.eyebrow')}</span>
      <h1>{t('downloadPage.title')}</h1>
      <p class="lede">{t('downloadPage.subtitle')}</p>
      <StoreBadges lang={lang} />
      <p class="hero-note">{t('cta.note')}</p>
    </div>

    <section class="section">
      <h2 class="text-center reveal">{t('downloadPage.stepsTitle')}</h2>
      <div class="steps-grid mt-3">
        {steps.map((s, i) => (
          <div class="step-card reveal" style={`transition-delay:${i * 80}ms`}>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section" style="padding-top:0">
      <h2 class="text-center reveal">{t('tools.title')}</h2>
      <p class="lede text-center reveal" style="margin-inline:auto">{t('tools.subtitle')}</p>
      <div class="tool-grid mt-3">
        {tools.slice(0, 8).map((tool, i) => (
          <div class="tool-card reveal" data-stage={tool.stage} style={`transition-delay:${(i % 4) * 60}ms`}>
            <span class="t-ico" aria-hidden="true">{toolEmojis[i]}</span>
            <h3>{tool.name}</h3>
            <p>{tool.desc}</p>
          </div>
        ))}
      </div>
      <div class="text-center mt-3">
        <a href={pagePath('features', lang)} class="btn btn-ghost">{t('tools.viewAll')}</a>
      </div>
    </section>

    <section class="section" style="padding-top:0">
      <div class="info-grid">
        <div class="info-card reveal">
          <span class="i-ico" aria-hidden="true">📱</span>
          <h3>{t('downloadPage.requirementsTitle')}</h3>
          <p>{t('downloadPage.requirements')}</p>
        </div>
        <div class="info-card reveal" style="transition-delay:70ms">
          <span class="i-ico" aria-hidden="true">🌍</span>
          <h3>{t('downloadPage.languagesTitle')}</h3>
          <p>{t('downloadPage.languagesText')}</p>
        </div>
        <div class="info-card reveal" style="transition-delay:140ms">
          <span class="i-ico" aria-hidden="true">🛡️</span>
          <h3>{t('downloadPage.securityTitle')}</h3>
          <p>{t('downloadPage.securityText')}</p>
        </div>
        <div class="info-card reveal" style="transition-delay:210ms">
          <span class="i-ico" aria-hidden="true">💛</span>
          <h3>{t('cta.title')}</h3>
          <p>{t('cta.subtitle')}</p>
        </div>
      </div>
    </section>
  </div>
</Base>
