---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CtaBand from '@/components/CtaBand.astro';
import { pagePath } from '@/config/pages';
import { useTranslations } from '@/i18n';
import { getCompetitorPages } from '@/utils/competitors';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const pages = await getCompetitorPages(lang);
const categories = [...new Set(pages.map((p) => p.entry.data.category))];

const breadcrumbs = [
  { name: t('breadcrumbs.home'), path: pagePath('home', lang) },
  { name: t('compare.hubTitle'), path: pagePath('competitors', lang) },
];
---

<Base
  lang={lang}
  title={t('meta.competitors.title')}
  description={t('meta.competitors.description')}
  pageKey="competitors"
  breadcrumbs={breadcrumbs}
>
  <div class="container">
    <div class="page-hero">
      <Breadcrumbs items={breadcrumbs} />
      <span class="eyebrow">{t('compare.eyebrow')}</span>
      <h1>{t('compare.hubTitle')}</h1>
      <p class="lede">{t('compare.hubSubtitle')}</p>
    </div>

    {
      categories.length > 1 && (
        <div class="tag-row mt-2" role="group" aria-label={t('blog.all')} id="cmp-filters">
          <button class="tag" data-filter="all" aria-pressed="true">{t('blog.all')}</button>
          {categories.map((c) => (
            <button class="tag" data-filter={c} aria-pressed="false">{t(`compare.categories.${c}`)}</button>
          ))}
        </div>
      )
    }

    <section class="section" style="padding-top:1.4rem">
      <h2 class="visually-hidden">{t('compare.hubTitle')}</h2>
      <div class="post-grid" id="cmp-grid">
        {pages.map((p, i) => (
          <a
            href={p.path}
            class="post-card reveal"
            data-category={p.entry.data.category}
            style={`transition-delay:${(i % 3) * 60}ms`}
          >
            <div class="post-cover" data-theme={p.entry.data.theme}>
              <span aria-hidden="true">{p.entry.data.emoji}</span>
              <span class="cat">{t(`compare.categories.${p.entry.data.category}`)}</span>
            </div>
            <div class="post-body">
              <h3>Anacan {t('compare.vs')} {p.entry.data.competitor}</h3>
              <p>{p.entry.data.description}</p>
              <div class="post-meta">
                <span>{p.readingTime} {t('blog.minRead')}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>

  <CtaBand lang={lang} title={t('compare.ctaTitle')} subtitle={t('compare.ctaText')} />

  <script>
    const filterWrap = document.getElementById('cmp-filters');
    const grid = document.getElementById('cmp-grid');
    if (filterWrap && grid) {
      const buttons = filterWrap.querySelectorAll<HTMLButtonElement>('[data-filter]');
      const cards = grid.querySelectorAll<HTMLElement>('[data-category]');
      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const filter = btn.dataset.filter;
          buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
          cards.forEach((card) => {
            card.style.display = filter === 'all' || card.dataset.category === filter ? '' : 'none';
          });
        });
      });
    }
  </script>
</Base>

<style>
  .tag-row button.tag[aria-pressed='true'] {
    background: var(--ink);
    color: #fff;
    box-shadow: none;
  }
</style>
