---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CtaBand from '@/components/CtaBand.astro';
import { pagePath } from '@/config/pages';
import { getLanguage } from '@/config/languages';
import { useTranslations } from '@/i18n';
import { getPosts, formatDate, type BlogPost } from '@/utils/blog';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const language = getLanguage(lang);

const posts = await getPosts(lang);
const featured: BlogPost | undefined = posts.find((p) => p.entry.data.featured) ?? posts[0];
const rest = posts.filter((p) => p !== featured);

const categories = [...new Set(posts.map((p) => p.entry.data.category))];

const breadcrumbs = [
  { name: t('breadcrumbs.home'), path: pagePath('home', lang) },
  { name: t('nav.blog'), path: pagePath('blog', lang) },
];
---

<Base
  lang={lang}
  title={t('meta.blog.title')}
  description={t('meta.blog.description')}
  pageKey="blog"
  breadcrumbs={breadcrumbs}
>
  <div class="container">
    <div class="page-hero">
      <Breadcrumbs items={breadcrumbs} />
      <span class="eyebrow">{t('blog.eyebrow')}</span>
      <h1>{t('blog.title')}</h1>
      <p class="lede">{t('blog.subtitle')}</p>
    </div>

    {
      posts.length === 0 ? (
        <section class="section">
          <p class="lede">{t('blog.empty')}</p>
        </section>
      ) : (
        <section class="section" style="padding-top:1rem">
          {featured && (
            <a href={featured.path} class="featured-post reveal">
              <div class="post-cover" data-theme={featured.entry.data.theme}>
                <span aria-hidden="true">{featured.entry.data.emoji}</span>
                <span class="cat">{t(`blog.categories.${featured.entry.data.category}`)}</span>
              </div>
              <div class="post-body">
                <span class="eyebrow" style="justify-self:start">{t('blog.featured')}</span>
                <h2>{featured.entry.data.title}</h2>
                <p>{featured.entry.data.description}</p>
                <div class="post-meta">
                  <time datetime={featured.entry.data.pubDate.toISOString()}>
                    {formatDate(featured.entry.data.pubDate, language.dateLocale)}
                  </time>
                  <span class="sep">·</span>
                  <span>{featured.readingTime} {t('blog.minRead')}</span>
                </div>
              </div>
            </a>
          )}

          {categories.length > 1 && (
            <div class="tag-row mt-2" role="group" aria-label={t('blog.all')} id="blog-filters">
              <button class="tag" data-filter="all" aria-pressed="true">{t('blog.all')}</button>
              {categories.map((c) => (
                <button class="tag" data-filter={c} aria-pressed="false">{t(`blog.categories.${c}`)}</button>
              ))}
            </div>
          )}

          <h2 class="visually-hidden">{t('blog.latest')}</h2>
          <div class="post-grid mt-3" id="post-grid">
            {rest.map((post, i) => (
              <a
                href={post.path}
                class="post-card reveal"
                data-category={post.entry.data.category}
                style={`transition-delay:${(i % 3) * 60}ms`}
              >
                <div class="post-cover" data-theme={post.entry.data.theme}>
                  <span aria-hidden="true">{post.entry.data.emoji}</span>
                  <span class="cat">{t(`blog.categories.${post.entry.data.category}`)}</span>
                </div>
                <div class="post-body">
                  <h3>{post.entry.data.title}</h3>
                  <p>{post.entry.data.description}</p>
                  <div class="post-meta">
                    <time datetime={post.entry.data.pubDate.toISOString()}>
                      {formatDate(post.entry.data.pubDate, language.dateLocale)}
                    </time>
                    <span class="sep">·</span>
                    <span>{post.readingTime} {t('blog.minRead')}</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </div>

  <CtaBand lang={lang} title={t('blog.ctaTitle')} subtitle={t('blog.ctaText')} />

  <script>
    const filterWrap = document.getElementById('blog-filters');
    const grid = document.getElementById('post-grid');
    if (filterWrap && grid) {
      const buttons = filterWrap.querySelectorAll<HTMLButtonElement>('[data-filter]');
      const cards = grid.querySelectorAll<HTMLElement>('[data-category]');
      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const filter = btn.dataset.filter;
          buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
          cards.forEach((card) => {
            card.style.display = filter === 'all' || card.dataset.category === filter ? '' : 'none';
          });
        });
      });
    }
  </script>
</Base>

<style>
  .tag-row button.tag {
    transition: background 0.15s, color 0.15s, box-shadow 0.15s;
  }

  .tag-row button.tag[aria-pressed='true'] {
    background: var(--ink);
    color: #fff;
    box-shadow: none;
  }
</style>
