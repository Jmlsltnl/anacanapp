---
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CtaBand from '@/components/CtaBand.astro';
import { SITE } from '@/config/site';
import { pagePath } from '@/config/pages';
import { getLanguage, DEFAULT_LANG } from '@/config/languages';
import { useTranslations } from '@/i18n';
import { getCompetitorAlternates, type CompetitorPage } from '@/utils/competitors';
import { COMPETITOR_MAP } from '@/config/competitors';
import { articleLd, type BreadcrumbItem } from '@/utils/seo';

interface Props {
  page: CompetitorPage;
}

const { page } = Astro.props;
const { lang, slug } = page;
const data = page.entry.data;
const t = useTranslations(lang);
const language = getLanguage(lang);
const site = Astro.site!;

const { Content } = await render(page.entry);
const facts = COMPETITOR_MAP[data.competitorSlug];

const siblings = await getCompetitorAlternates(data.translationKey);
const alternates: { hreflang: string; href: string; code?: string }[] = siblings.map((p) => ({
  hreflang: getLanguage(p.lang).bcp47,
  href: new URL(p.path, site).href,
  code: p.lang,
}));
const xDefault = siblings.find((p) => p.lang === DEFAULT_LANG) ?? page;
alternates.push({ hreflang: 'x-default', href: new URL(xDefault.path, site).href });

const ogImage = `/og/blog/${lang}/${slug}.png`;
const categoryLabel = t(`compare.categories.${data.category}`);
const titleH1 = `Anacan ${t('compare.vs')} ${data.competitor}`;

/* <title> tag: prefer the rich, keyword-full frontmatter title (each
   comparison article ships one, e.g. "Anacan vs Flo: Which App Should You
   Choose? (2026)") over the short generic "Anacan vs X" H1 pattern. */
const titleTag = data.title.length >= 25 ? data.title : `${titleH1} — Anacan`;

const breadcrumbs: BreadcrumbItem[] = [
  { name: t('breadcrumbs.home'), path: pagePath('home', lang) },
  { name: t('compare.hubTitle'), path: pagePath('competitors', lang) },
  { name: titleH1, path: page.path },
];

const wordCount = (page.entry.body ?? '').replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;

const extraLd = [
  articleLd(site, {
    title: data.title,
    description: data.description,
    path: page.path,
    lang,
    pubDate: data.pubDate,
    updatedDate: data.updatedDate,
    image: ogImage,
    section: categoryLabel,
    tags: [data.competitor, 'Anacan', categoryLabel],
    authorName: t('blog.authorName'),
    wordCount,
  }),
];

/* At-a-glance table rows (structured facts, identical shape on every page —
   the narrative body below is what stays genuinely unique per language). */
const rows: { label: string; anacan: string; them: string }[] = [
  { label: t('compare.factFounded'), anacan: String(SITE.foundingYear), them: facts.founded },
  { label: t('compare.factHq'), anacan: `${t('compare.bakuHq')}`, them: facts.hq },
  { label: t('compare.factPlatforms'), anacan: 'iOS, Android', them: facts.platforms },
  { label: t('compare.factLanguages'), anacan: '5 (AZ/EN/RU/TR/KK)', them: t('compare.varies') },
  { label: t('compare.factStages'), anacan: t('compare.fourStages'), them: t(`compare.categories.${data.category}`) },
  { label: t('compare.factAi'), anacan: '✓ Anacan.AI 24/7', them: t('compare.unknown') },
  { label: t('compare.factPartner'), anacan: '✓', them: t('compare.unknown') },
  { label: t('compare.factFree'), anacan: '✓', them: t('compare.freemium') },
];
---

<Base
  lang={lang}
  title={titleTag}
  description={data.description}
  alternates={alternates}
  ogImage={ogImage}
  ogType="article"
  breadcrumbs={breadcrumbs}
  extraLd={extraLd}
  article={{ pubDate: data.pubDate, updatedDate: data.updatedDate, section: categoryLabel, tags: [data.competitor] }}
>
  <article>
    <div class="container">
      <header class="article-hero">
        <Breadcrumbs items={breadcrumbs.slice(0, 2)} />
        <span class={`eyebrow ${data.theme}`}>{categoryLabel}</span>
        <h1>{titleH1}</h1>
        <p class="lede">{data.description}</p>
      </header>

      <div class="mt-3" style="max-width:780px;margin-inline:auto;overflow-x:auto">
        <table class="compare-table">
          <thead>
            <tr>
              <th scope="col">{t('compare.factLabel')}</th>
              <th scope="col">Anacan</th>
              <th scope="col">{data.competitor}</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td>{r.label}</td>
                <td>{r.anacan}</td>
                <td>{r.them}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="ai-disclaimer mt-2">
          {t('compare.factsNote')} <a class="link" href={facts.website} rel="nofollow noopener" target="_blank">{data.competitor} →</a>
        </p>
      </div>

      <div class="prose section" style="padding-top:2rem">
        <Content />
      </div>

      <footer class="article-foot">
        <p class="ai-disclaimer">{t('compare.disclaimer')}</p>
        <a href={pagePath('competitors', lang)} class="btn btn-ghost" style="justify-self:start">
          ← {t('compare.backToHub')}
        </a>
      </footer>
    </div>

    <CtaBand lang={lang} title={t('compare.ctaTitle')} subtitle={t('compare.ctaText')} />
  </article>
</Base>
