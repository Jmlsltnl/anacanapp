---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { pagePath } from '@/config/pages';
import { useTranslations } from '@/i18n';

interface Props {
  lang: string;
  doc: 'privacy' | 'terms';
}

const { lang, doc } = Astro.props;
const t = useTranslations(lang);
const dictKey = doc === 'privacy' ? 'legalPrivacy' : 'legalTerms';
const sections = t<{ h: string; p: string }[]>(`${dictKey}.sections`);

const breadcrumbs = [
  { name: t('breadcrumbs.home'), path: pagePath('home', lang) },
  { name: t(`${dictKey}.title`), path: pagePath(doc, lang) },
];
---

<Base
  lang={lang}
  title={t(`meta.${doc}.title`)}
  description={t(`meta.${doc}.description`)}
  pageKey={doc}
  breadcrumbs={breadcrumbs}
>
  <div class="container">
    <div class="page-hero">
      <Breadcrumbs items={breadcrumbs} />
      <h1>{t(`${dictKey}.title`)}</h1>
      <p class="updated" style="font-weight:700;color:var(--ink-faint)">{t(`${dictKey}.updated`)}</p>
    </div>

    <div class="legal section" style="padding-top:0">
      <p class="lede">{t(`${dictKey}.intro`)}</p>
      {sections.map((s) => (
        <section>
          <h2>{s.h}</h2>
          <p>{s.p}</p>
        </section>
      ))}
    </div>
  </div>
</Base>
