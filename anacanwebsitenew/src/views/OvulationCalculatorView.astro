---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import FaqList from '@/components/FaqList.astro';
import CtaBand from '@/components/CtaBand.astro';
import { pagePath } from '@/config/pages';
import { getLanguage } from '@/config/languages';
import { useTranslations } from '@/i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const language = getLanguage(lang);

const signs = t<{ title: string; text: string }[]>('ovulationPage.signs');
const faq = t<{ q: string; a: string }[]>('ovulationPage.faq');

const breadcrumbs = [
  { name: t('breadcrumbs.home'), path: pagePath('home', lang) },
  { name: t('ovulationPage.title'), path: pagePath('ovulation', lang) },
];
---

<Base
  lang={lang}
  title={t('meta.ovulation.title')}
  description={t('meta.ovulation.description')}
  pageKey="ovulation"
  breadcrumbs={breadcrumbs}
>
  <div class="container">
    <div class="page-hero">
      <Breadcrumbs items={breadcrumbs} />
      <span class="eyebrow flow">{t('ovulationPage.eyebrow')} 🌸</span>
      <h1>{t('ovulationPage.title')}</h1>
      <p class="lede">{t('ovulationPage.subtitle')}</p>
    </div>

    <section style="padding-top:0.5rem">
      <div class="calc-card" data-locale={language.dateLocale}>
        <form id="ovulation-form" class="calc-form" novalidate>
          <div class="calc-field">
            <label for="lastPeriod">{t('ovulationPage.formLastPeriod')}</label>
            <input type="date" id="lastPeriod" name="lastPeriod" required />
          </div>
          <div class="calc-field">
            <label for="cycleLength">{t('ovulationPage.formCycleLength')}</label>
            <input type="number" id="cycleLength" name="cycleLength" min="21" max="40" step="1" value="28" required />
            <small>{t('ovulationPage.formCycleLengthHint')}</small>
          </div>
          <button type="submit" class="btn btn-primary calc-submit">{t('ovulationPage.calculate')}</button>
          <p id="ovulation-error" class="calc-error" role="alert" hidden>{t('ovulationPage.errorMsg')}</p>
        </form>

        <div id="ovulation-results" class="calc-results" hidden>
          <h2>{t('ovulationPage.resultsTitle')}</h2>
          <div class="calc-result-grid">
            <div class="calc-result flow">
              <span class="calc-result-label">{t('ovulationPage.resultFertileWindow')}</span>
              <span class="calc-result-value" id="res-fertile"></span>
            </div>
            <div class="calc-result bump">
              <span class="calc-result-label">{t('ovulationPage.resultOvulation')}</span>
              <span class="calc-result-value" id="res-ovulation"></span>
            </div>
            <div class="calc-result mommy">
              <span class="calc-result-label">{t('ovulationPage.resultNextPeriod')}</span>
              <span class="calc-result-value" id="res-next"></span>
            </div>
          </div>
          <p class="calc-note">{t('ovulationPage.resultNote')}</p>
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:2.4rem">
      <p class="lede reveal" style="max-width:56em">{t('ovulationPage.intro')}</p>

      <h2 class="mt-4 reveal">{t('ovulationPage.howTitle')}</h2>
      <p class="mt-2 reveal" style="max-width:56em;color:var(--ink-soft)">{t('ovulationPage.howText')}</p>

      <h2 class="mt-4 reveal">{t('ovulationPage.accuracyTitle')}</h2>
      <p class="mt-2 reveal" style="max-width:56em;color:var(--ink-soft)">{t('ovulationPage.accuracyText')}</p>
    </section>

    <section class="section" style="padding-top:0">
      <h2 class="reveal">{t('ovulationPage.signsTitle')}</h2>
      <div class="tool-grid mt-3">
        {signs.map((s, i) => (
          <div class="tool-card reveal" data-stage="flow" style={`transition-delay:${i * 60}ms`}>
            <span class="t-ico" aria-hidden="true">🌸</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section" style="padding-top:0">
      <h2 class="text-center reveal">{t('ovulationPage.faqTitle')}</h2>
      <div class="mt-3">
        <FaqList items={faq} openFirst={false} />
      </div>
    </section>
  </div>

  <CtaBand lang={lang} title={t('ovulationPage.ctaTitle')} subtitle={t('ovulationPage.ctaText')} />
</Base>

<style>
  .calc-card {
    background: var(--surface);
    border-radius: var(--r-xl);
    box-shadow: var(--shadow-lg);
    padding: clamp(1.6rem, 4vw, 2.6rem);
    display: grid;
    gap: 1.6rem;
  }

  .calc-form {
    display: grid;
    gap: 1.1rem;
  }

  @media (min-width: 720px) {
    .calc-form {
      grid-template-columns: 1fr 1fr auto;
      align-items: end;
    }
  }

  .calc-field {
    display: grid;
    gap: 0.4rem;
  }

  .calc-field label {
    font-weight: 800;
    font-size: 0.92rem;
  }

  .calc-field input {
    font: inherit;
    font-size: 1rem;
    padding: 0.85rem 1rem;
    border-radius: 14px;
    border: 2px solid #f3ddd3;
    background: var(--bg-soft);
    color: var(--ink);
  }

  .calc-field input:focus-visible {
    outline: none;
    border-color: var(--coral);
  }

  .calc-field small {
    color: var(--ink-faint);
    font-size: 0.8rem;
    font-weight: 650;
  }

  .calc-submit {
    height: fit-content;
    white-space: nowrap;
  }

  .calc-error {
    grid-column: 1 / -1;
    color: var(--coral-deep);
    font-weight: 750;
    font-size: 0.9rem;
    margin: 0;
  }

  .calc-results {
    border-top: 2px solid var(--bg-soft);
    padding-top: 1.4rem;
    display: grid;
    gap: 1rem;
  }

  .calc-results h2 {
    font-size: 1.3rem;
  }

  .calc-result-grid {
    display: grid;
    gap: 0.9rem;
  }

  @media (min-width: 720px) {
    .calc-result-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .calc-result {
    border-radius: var(--r-md);
    padding: 1.1rem 1.2rem;
    display: grid;
    gap: 0.3rem;
  }

  .calc-result.flow { background: var(--flow-soft); }
  .calc-result.bump { background: var(--bump-soft); }
  .calc-result.mommy { background: var(--mommy-soft); }

  .calc-result-label {
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
  }

  .calc-result-value {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .calc-note {
    font-size: 0.88rem;
    color: var(--ink-faint);
    font-weight: 650;
  }
</style>

<script>
  const form = document.getElementById('ovulation-form') as HTMLFormElement | null;
  const errorEl = document.getElementById('ovulation-error');
  const resultsEl = document.getElementById('ovulation-results');
  const locale = (document.querySelector('.calc-card') as HTMLElement | null)?.dataset.locale || 'en-US';

  /*
   * Hardcoded month names instead of Intl.DateTimeFormat's `month: 'long'`.
   * Some browser/WebView builds ship "small ICU" (a size-reduced locale
   * database) that lacks full data for less-common locale tags like
   * az-Latn-AZ or kk-KZ, silently falling back to a generic "2026 M07 17"
   * format instead of real month names. A static lookup renders correctly
   * on every device regardless of the host's ICU data completeness.
   */
  const MONTHS: Record<string, string[]> = {
    az: ['yanvar', 'fevral', 'mart', 'aprel', 'may', 'iyun', 'iyul', 'avqust', 'sentyabr', 'oktyabr', 'noyabr', 'dekabr'],
    ru: ['января', 'февраля', 'марта', 'апреля', 'мая', 'июня', 'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря'],
    tr: ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'],
    kk: ['қаңтар', 'ақпан', 'наурыз', 'сәуір', 'мамыр', 'маусым', 'шілде', 'тамыз', 'қыркүйек', 'қазан', 'қараша', 'желтоқсан'],
    en: ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'],
  };
  const langCode = locale.split(/[-_]/)[0].toLowerCase();
  const months = MONTHS[langCode] ?? MONTHS.en;

  const fmt = { format: (d: Date) => `${d.getDate()} ${months[d.getMonth()]} ${d.getFullYear()}` };
  const addDays = (d: Date, n: number) => {
    const out = new Date(d);
    out.setDate(out.getDate() + n);
    return out;
  };

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const lastPeriodRaw = String(data.get('lastPeriod') || '');
    const cycleLength = Number(data.get('cycleLength')) || 28;

    if (!lastPeriodRaw) {
      errorEl?.removeAttribute('hidden');
      resultsEl?.setAttribute('hidden', '');
      return;
    }
    errorEl?.setAttribute('hidden', '');

    // Parse as a plain calendar date (no timezone shift).
    const [y, m, d] = lastPeriodRaw.split('-').map(Number);
    const lastPeriod = new Date(y, (m || 1) - 1, d || 1);

    const nextPeriod = addDays(lastPeriod, cycleLength);
    const ovulation = addDays(nextPeriod, -14);
    const fertileStart = addDays(ovulation, -5);
    const fertileEnd = addDays(ovulation, 1);

    const setText = (id: string, value: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = value;
    };

    setText('res-ovulation', fmt.format(ovulation));
    setText('res-next', fmt.format(nextPeriod));
    setText('res-fertile', `${fmt.format(fertileStart)} – ${fmt.format(fertileEnd)}`);

    resultsEl?.removeAttribute('hidden');
    resultsEl?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });
</script>
