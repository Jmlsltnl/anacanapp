---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import FaqList from '@/components/FaqList.astro';
import CtaBand from '@/components/CtaBand.astro';
import { pagePath } from '@/config/pages';
import { useTranslations } from '@/i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const list = t<{ title: string; text: string }[]>('symptomsPage.list');
const comparisonHead = t<string[]>('symptomsPage.comparisonHead');
const comparison = t<{ s: string; p: string; m: string }[]>('symptomsPage.comparison');
const faq = t<{ q: string; a: string }[]>('symptomsPage.faq');

const breadcrumbs = [
  { name: t('breadcrumbs.home'), path: pagePath('home', lang) },
  { name: t('symptomsPage.title'), path: pagePath('symptoms', lang) },
];
---

<Base
  lang={lang}
  title={t('meta.symptoms.title')}
  description={t('meta.symptoms.description')}
  pageKey="symptoms"
  breadcrumbs={breadcrumbs}
>
  <div class="container">
    <div class="page-hero">
      <Breadcrumbs items={breadcrumbs} />
      <span class="eyebrow bump">{t('symptomsPage.eyebrow')} 🤰</span>
      <h1>{t('symptomsPage.title')}</h1>
      <p class="lede">{t('symptomsPage.subtitle')}</p>
    </div>

    <section style="padding-top:0.5rem">
      <div class="takeaways">
        <p style="margin:0;font-size:1.05rem;line-height:1.7">{t('symptomsPage.intro')}</p>
      </div>
    </section>

    <section class="section" style="padding-top:1.6rem">
      <h2 class="reveal">{t('symptomsPage.listTitle')}</h2>
      <div class="tool-grid mt-3">
        {list.map((s, i) => (
          <div class="tool-card reveal" data-stage="bump" style={`transition-delay:${(i % 4) * 60}ms`}>
            <span class="t-ico" aria-hidden="true">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section" style="padding-top:0">
      <h2 class="reveal">{t('symptomsPage.comparisonTitle')}</h2>
      <p class="lede mt-2 reveal" style="max-width:56em">{t('symptomsPage.comparisonIntro')}</p>
      <div class="mt-3 reveal" style="overflow-x:auto">
        <table class="compare-table">
          <thead>
            <tr>
              {comparisonHead.map((h) => <th scope="col">{h}</th>)}
            </tr>
          </thead>
          <tbody>
            {comparison.map((row) => (
              <tr>
                <td>{row.s}</td>
                <td>{row.p}</td>
                <td>{row.m}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section split" style="padding-top:0">
      <div class="reveal">
        <h2>{t('symptomsPage.whenTestTitle')}</h2>
        <p class="lede mt-2">{t('symptomsPage.whenTestText')}</p>
      </div>
      <div class="reveal" style="transition-delay:80ms">
        <h2>{t('symptomsPage.whenDoctorTitle')}</h2>
        <p class="lede mt-2">{t('symptomsPage.whenDoctorText')}</p>
      </div>
    </section>

    <section class="section" style="padding-top:0">
      <h2 class="text-center reveal">{t('symptomsPage.faqTitle')}</h2>
      <div class="mt-3">
        <FaqList items={faq} openFirst={false} />
      </div>
    </section>
  </div>

  <CtaBand lang={lang} title={t('symptomsPage.ctaTitle')} subtitle={t('symptomsPage.ctaText')} />
</Base>
