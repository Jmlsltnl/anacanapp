---
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CtaBand from '@/components/CtaBand.astro';
import { pagePath } from '@/config/pages';
import { getLanguage, DEFAULT_LANG } from '@/config/languages';
import { useTranslations } from '@/i18n';
import { getAlternates, getRelated, formatDate, type BlogPost } from '@/utils/blog';
import { articleLd, type BreadcrumbItem } from '@/utils/seo';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { lang, slug } = post;
const data = post.entry.data;
const t = useTranslations(lang);
const language = getLanguage(lang);
const site = Astro.site!;

const { Content } = await render(post.entry);

/* hreflang alternates via translationKey */
const siblings = await getAlternates(data.translationKey);
const alternates: { hreflang: string; href: string; code?: string }[] = siblings.map((p) => ({
  hreflang: getLanguage(p.lang).bcp47,
  href: new URL(p.path, site).href,
  code: p.lang,
}));
const xDefault = siblings.find((p) => p.lang === DEFAULT_LANG) ?? post;
alternates.push({ hreflang: 'x-default', href: new URL(xDefault.path, site).href });

const related = await getRelated(post);

const ogImage = `/og/blog/${lang}/${slug}.png`;
const categoryLabel = t(`blog.categories.${data.category}`);
const authorName = data.author ?? t('blog.authorName');

const breadcrumbs: BreadcrumbItem[] = [
  { name: t('breadcrumbs.home'), path: pagePath('home', lang) },
  { name: t('nav.blog'), path: pagePath('blog', lang) },
  { name: data.title, path: post.path },
];

const wordCount = (post.entry.body ?? '')
  .replace(/<[^>]+>/g, ' ')
  .split(/\s+/)
  .filter(Boolean).length;

/*
 * <title> tag: DB titles can be long (up to ~120 chars).
 *  - short titles get the brand suffix
 *  - 51–68 chars: used as-is
 *  - longer: cut at a word boundary (~62 chars) for SERP-safe length;
 *    the visible H1 always shows the full title.
 */
const rawTitle = data.title;
const titleTag =
  rawTitle.length <= 50
    ? `${rawTitle} — Anacan`
    : rawTitle.length <= 65
      ? rawTitle
      : `${rawTitle.slice(0, 62).replace(/\s+\S*$/, '')}…`;

const extraLd = [
  articleLd(site, {
    title: data.title,
    description: data.description,
    path: post.path,
    lang,
    pubDate: data.pubDate,
    updatedDate: data.updatedDate,
    image: ogImage,
    section: categoryLabel,
    tags: data.tags,
    authorName,
    wordCount,
  }),
];
---

<Base
  lang={lang}
  title={titleTag}
  description={data.description}
  alternates={alternates}
  ogImage={ogImage}
  ogType="article"
  breadcrumbs={breadcrumbs}
  extraLd={extraLd}
  article={{ pubDate: data.pubDate, updatedDate: data.updatedDate, section: categoryLabel, tags: data.tags }}
>
  <article>
    <div class="container">
      <header class="article-hero">
        <Breadcrumbs items={breadcrumbs.slice(0, 2)} />
        <span class={`eyebrow ${data.theme}`}>{categoryLabel}</span>
        <h1>{data.title}</h1>
        <p class="lede">{data.description}</p>
        <div class="post-meta">
          <span>{t('blog.author')}: <b>{authorName}</b></span>
          <span class="sep">·</span>
          <time datetime={data.pubDate.toISOString()}>
            {t('blog.published')}: {formatDate(data.pubDate, language.dateLocale)}
          </time>
          {
            data.updatedDate && (
              <>
                <span class="sep">·</span>
                <time datetime={data.updatedDate.toISOString()}>
                  {t('blog.updated')}: {formatDate(data.updatedDate, language.dateLocale)}
                </time>
              </>
            )
          }
          <span class="sep">·</span>
          <span>{post.readingTime} {t('blog.minRead')}</span>
        </div>
      </header>

      <div
        class="post-cover mt-3"
        data-theme={data.theme}
        style="max-width:780px;margin-inline:auto;border-radius:var(--r-xl);font-size:4rem"
      >
        {
          data.cover ? (
            <img
              class="cover-img"
              src={data.cover}
              alt={data.title}
              width="780"
              height="439"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          ) : (
            <span aria-hidden="true">{data.emoji}</span>
          )
        }
      </div>

      <div class="prose section" style="padding-top:2.2rem">
        <Content />
      </div>

      <footer class="article-foot">
        {
          data.tags.length > 0 && (
            <div class="tag-row">
              {data.tags.map((tag) => (
                <span class="tag">#{tag}</span>
              ))}
            </div>
          )
        }
        <a href={pagePath('blog', lang)} class="btn btn-ghost" style="justify-self:start">
          ← {t('blog.backToBlog')}
        </a>
      </footer>

      {
        related.length > 0 && (
          <section class="section">
            <h2 class="reveal">{t('blog.related')}</h2>
            <div class="post-grid mt-3">
              {related.map((rp, i) => (
                <a href={rp.path} class="post-card reveal" style={`transition-delay:${i * 60}ms`}>
                  <div class="post-cover" data-theme={rp.entry.data.theme}>
                    {rp.entry.data.cover ? (
                      <img
                        class="cover-img"
                        src={rp.entry.data.cover}
                        alt={rp.entry.data.title}
                        width="640"
                        height="360"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span aria-hidden="true">{rp.entry.data.emoji}</span>
                    )}
                    <span class="cat">{t(`blog.categories.${rp.entry.data.category}`)}</span>
                  </div>
                  <div class="post-body">
                    <h3>{rp.entry.data.title}</h3>
                    <p>{rp.entry.data.description}</p>
                    <div class="post-meta">
                      <time datetime={rp.entry.data.pubDate.toISOString()}>
                        {formatDate(rp.entry.data.pubDate, language.dateLocale)}
                      </time>
                      <span class="sep">·</span>
                      <span>
                        {rp.readingTime} {t('blog.minRead')}
                      </span>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )
      }
    </div>

    <CtaBand lang={lang} title={t('blog.ctaTitle')} subtitle={t('blog.ctaText')} />
  </article>
</Base>
