---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import FaqList from '@/components/FaqList.astro';
import CtaBand from '@/components/CtaBand.astro';
import { pagePath } from '@/config/pages';
import { useTranslations } from '@/i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const items = t<{ q: string; a: string }[]>('faqPage.items');

const breadcrumbs = [
  { name: t('breadcrumbs.home'), path: pagePath('home', lang) },
  { name: t('nav.faq'), path: pagePath('faq', lang) },
];
---

<Base
  lang={lang}
  title={t('meta.faq.title')}
  description={t('meta.faq.description')}
  pageKey="faq"
  breadcrumbs={breadcrumbs}
>
  <div class="container">
    <div class="page-hero center" style="justify-items:center;text-align:center;margin-inline:auto;max-width:46em">
      <Breadcrumbs items={breadcrumbs} />
      <span class="eyebrow">{t('faqPage.eyebrow')}</span>
      <h1>{t('faqPage.title')}</h1>
      <p class="lede">{t('faqPage.subtitle')}</p>
    </div>

    <section class="section" style="padding-top:1.5rem">
      <h2 class="visually-hidden">{t('faqPage.eyebrow')}</h2>
      <FaqList items={items} />
      <div class="info-card mt-4 reveal" style="max-width:560px;margin-inline:auto;text-align:center;justify-items:center">
        <h3>{t('faqPage.stillTitle')}</h3>
        <p>{t('faqPage.stillText')}</p>
        <a href={pagePath('contact', lang)} class="btn btn-primary btn-sm mt-1">{t('faqPage.stillCta')}</a>
      </div>
    </section>
  </div>

  <CtaBand lang={lang} />
</Base>
