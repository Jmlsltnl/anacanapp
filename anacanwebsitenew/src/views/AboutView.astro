---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CtaBand from '@/components/CtaBand.astro';
import { SITE } from '@/config/site';
import { pagePath } from '@/config/pages';
import { useTranslations } from '@/i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const values = t<{ title: string; text: string }[]>('aboutPage.values');
const facts = t<{ value: string; label: string }[]>('aboutPage.facts');
const valueEmojis = ['🔬', '🔒', '🗣️', '💛'];

const breadcrumbs = [
  { name: t('breadcrumbs.home'), path: pagePath('home', lang) },
  { name: t('nav.about'), path: pagePath('about', lang) },
];
---

<Base
  lang={lang}
  title={t('meta.about.title')}
  description={t('meta.about.description')}
  pageKey="about"
  breadcrumbs={breadcrumbs}
>
  <div class="container">
    <div class="page-hero">
      <Breadcrumbs items={breadcrumbs} />
      <span class="eyebrow">{t('aboutPage.eyebrow')}</span>
      <h1>{t('aboutPage.title')}</h1>
      <p class="lede">{t('aboutPage.subtitle')}</p>
    </div>

    <section class="section" style="padding-top:1rem">
      <div class="split">
        <div class="reveal">
          <h2>{t('aboutPage.missionTitle')}</h2>
          <p class="lede mt-2">{t('aboutPage.mission1')}</p>
          <p class="lede mt-2">{t('aboutPage.mission2')}</p>
        </div>
        <div class="cta-band reveal" style="padding:clamp(2rem,5vw,3rem)">
          <h2 style="font-size:clamp(1.5rem,3vw,2.2rem)">{t('aboutPage.visionTitle')}</h2>
          <p class="lede">“{t('aboutPage.vision')}”</p>
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:0">
      <h2 class="reveal">{t('aboutPage.valuesTitle')}</h2>
      <div class="value-grid mt-3">
        {values.map((v, i) => (
          <div class="tool-card reveal" style={`transition-delay:${i * 70}ms`}>
            <span class="t-ico" style="background:var(--peach)" aria-hidden="true">{valueEmojis[i]}</span>
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section" style="padding-top:0">
      <div class="split reverse">
        <div class="reveal">
          <h2>{t('aboutPage.storyTitle')}</h2>
          <p class="lede mt-2">{t('aboutPage.story1')}</p>
          <p class="lede mt-2">{t('aboutPage.story2')}</p>
          <p class="lede mt-2">{t('aboutPage.story3')}</p>
        </div>
        <div>
          <h2 class="visually-hidden">{t('aboutPage.factsTitle')}</h2>
          <div class="hero-stats" style="grid-template-columns:repeat(2,minmax(0,1fr))">
            {facts.map((f, i) => (
              <div class="stat reveal" style={`transition-delay:${i * 70}ms;padding:1.4rem 1.3rem`}>
                <b>{f.value}</b>
                <span>{f.label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:0">
      <div class="info-card reveal" style="max-width:560px">
        <span class="i-ico" aria-hidden="true">✉️</span>
        <h3>{t('aboutPage.contactTitle')}</h3>
        <p>{t('aboutPage.contactText')}</p>
        <a class="link" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>
    </section>
  </div>

  <CtaBand lang={lang} title={t('aboutPage.ctaTitle')} subtitle={t('aboutPage.ctaText')} />
</Base>
