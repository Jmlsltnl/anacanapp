---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Tools from '@/components/home/Tools.astro';
import CtaBand from '@/components/CtaBand.astro';
import { pagePath } from '@/config/pages';
import { useTranslations } from '@/i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const aiTools = t<{ name: string; desc: string }[]>('featuresPage.aiTools');
const aiEmojis = ['🍼', '🔍', '📸', '🧚', '✅', '🌤️'];

const breadcrumbs = [
  { name: t('breadcrumbs.home'), path: pagePath('home', lang) },
  { name: t('nav.features'), path: pagePath('features', lang) },
];
---

<Base
  lang={lang}
  title={t('meta.features.title')}
  description={t('meta.features.description')}
  pageKey="features"
  breadcrumbs={breadcrumbs}
>
  <div class="container">
    <div class="page-hero">
      <Breadcrumbs items={breadcrumbs} />
      <span class="eyebrow">{t('featuresPage.eyebrow')}</span>
      <h1>{t('featuresPage.title')}</h1>
      <p class="lede">{t('featuresPage.subtitle')}</p>
    </div>
  </div>

  <Tools lang={lang} showCta={false} />

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">✦ AI</span>
        <h2>{t('featuresPage.aiGroupTitle')}</h2>
        <p class="lede">{t('featuresPage.aiGroupText')}</p>
      </div>
      <div class="tool-grid">
        {aiTools.map((tool, i) => (
          <div class="tool-card reveal" data-stage="ai" style={`transition-delay:${(i % 3) * 60}ms`}>
            <span class="t-ico" aria-hidden="true">{aiEmojis[i]}</span>
            <h3>{tool.name}</h3>
            <p>{tool.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand lang={lang} title={t('featuresPage.ctaTitle')} subtitle={t('featuresPage.ctaText')} />
</Base>
