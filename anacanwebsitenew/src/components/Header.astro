---
import { Image } from 'astro:assets';
import logo from '@/assets/logo.png';
import { pagePath, type PageKey } from '@/config/pages';
import { useTranslations } from '@/i18n';
import { SITE } from '@/config/site';

interface SwitcherLink {
  code: string;
  native: string;
  flag: string;
  href: string;
  current: boolean;
}

interface Props {
  lang: string;
  switcherLinks: SwitcherLink[];
}

const { lang, switcherLinks } = Astro.props;
const t = useTranslations(lang);

const navItems: { key: PageKey; label: string }[] = [
  { key: 'features', label: t('nav.features') },
  { key: 'ai', label: t('nav.ai') },
  { key: 'premium', label: t('nav.premium') },
  { key: 'blog', label: t('nav.blog') },
  { key: 'about', label: t('nav.about') },
];

const current = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isCurrent = (href: string) => (href === current ? 'page' : undefined);
const currentLang = switcherLinks.find((l) => l.current);
---

<header class="site-header">
  <div class="container header-inner">
    <a href={pagePath('home', lang)} class="brand" aria-label={SITE.name}>
      <Image src={logo} alt="" width={76} height={76} loading="eager" />
      <span>Anacan</span>
    </a>

    <nav class="main-nav" aria-label={t('nav.menu')}>
      {navItems.map((item) => (
        <a href={pagePath(item.key, lang)} aria-current={isCurrent(pagePath(item.key, lang))}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <div class="lang-switch" data-open="false">
        <button class="lang-btn" aria-expanded="false" aria-haspopup="true" aria-label={t('nav.language')}>
          <span aria-hidden="true">{currentLang?.flag}</span>
          {lang}
          <svg class="chev" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <div class="lang-menu" role="menu">
          {switcherLinks.map((l) => (
            <a href={l.href} role="menuitem" aria-current={l.current ? 'true' : undefined} lang={l.code} hreflang={l.code}>
              <span class="flag" aria-hidden="true">{l.flag}</span>
              {l.native}
            </a>
          ))}
        </div>
      </div>

      <a href={pagePath('download', lang)} class="btn btn-primary btn-sm">{t('nav.download')}</a>

      <button class="nav-toggle" data-menu-open aria-expanded="false" aria-label={t('nav.menu')}>
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
          <path d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" data-open="false">
  <div class="mobile-menu-head">
    <a href={pagePath('home', lang)} class="brand" aria-label={SITE.name}>
      <Image src={logo} alt="" width={76} height={76} />
      <span>Anacan</span>
    </a>
    <button class="nav-toggle" data-menu-close aria-label={t('nav.close')}>
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
        <path d="M5 5l12 12M17 5 5 17" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
      </svg>
    </button>
  </div>
  <nav aria-label={t('nav.menu')}>
    <a href={pagePath('home', lang)}>{t('nav.home')}</a>
    {navItems.map((item) => (
      <a href={pagePath(item.key, lang)}>{item.label}</a>
    ))}
    <a href={pagePath('faq', lang)}>{t('nav.faq')}</a>
    <a href={pagePath('contact', lang)}>{t('nav.contact')}</a>
  </nav>
  <a href={pagePath('download', lang)} class="btn btn-primary mt-3">{t('nav.download')}</a>
  <div class="mobile-langs">
    {switcherLinks.map((l) => (
      <a href={l.href} aria-current={l.current ? 'true' : undefined} lang={l.code} hreflang={l.code}>
        {l.flag} {l.native}
      </a>
    ))}
  </div>
</div>
