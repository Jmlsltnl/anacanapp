---
import StoreBadges from '@/components/StoreBadges.astro';
import { useTranslations } from '@/i18n';

interface Props {
  lang: string;
  title?: string;
  subtitle?: string;
}

const { lang, title, subtitle } = Astro.props;
const t = useTranslations(lang);
---

<section class="section" id="download-cta">
  <div class="container">
    <div class="cta-band reveal">
      <h2>{title ?? t('cta.title')}</h2>
      <p class="lede">{subtitle ?? t('cta.subtitle')}</p>
      <StoreBadges lang={lang} />
      <p class="cta-note">{t('cta.note')}</p>
    </div>
  </div>
</section>
