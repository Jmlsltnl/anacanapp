---
import { SITE } from '@/config/site';
import { useTranslations } from '@/i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="store-badges">
  <a
    href={SITE.app.appStoreUrl}
    class="store-badge"
    rel="noopener"
    target="_blank"
    aria-label={t('cta.appStoreAria')}
  >
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M17.05 12.54c-.03-2.89 2.36-4.28 2.47-4.35-1.35-1.97-3.44-2.24-4.18-2.27-1.78-.18-3.47 1.05-4.37 1.05-.9 0-2.29-1.02-3.77-1-1.94.03-3.72 1.13-4.72 2.86-2.01 3.49-.51 8.66 1.45 11.49.96 1.39 2.1 2.94 3.6 2.88 1.45-.06 1.99-.93 3.74-.93s2.24.93 3.77.9c1.56-.03 2.54-1.41 3.49-2.8 1.1-1.61 1.55-3.17 1.58-3.25-.04-.02-3.03-1.16-3.06-4.58z"
      ></path>
      <path
        d="M14.16 4.04c.8-.97 1.34-2.32 1.19-3.66-1.15.05-2.55.77-3.38 1.73-.74.86-1.39 2.23-1.22 3.55 1.29.1 2.6-.65 3.41-1.62z"
      ></path>
    </svg>
    <span class="sb-label">
      <small>{t('badges.downloadOnThe')}</small>
      <strong>{t('badges.appStore')}</strong>
    </span>
  </a>

  <a
    href={SITE.app.playStoreUrl}
    class="store-badge"
    rel="noopener"
    target="_blank"
    aria-label={t('cta.googlePlayAria')}
  >
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M4 2.5v19a1 1 0 0 0 1.51.86L7 21.5 14.5 12 7 2.5 5.51 1.64A1 1 0 0 0 4 2.5z" fill="#57cef5"></path>
      <path d="M17.5 8.7 7 2.5 14.5 12 17.5 8.7z" fill="#5ee79b"></path>
      <path d="M17.5 15.3 14.5 12 7 21.5l10.5-6.2z" fill="#ff7c66"></path>
      <path d="M17.5 8.7 14.5 12l3 3.3 2.72-1.6a2 2 0 0 0 0-3.4L17.5 8.7z" fill="#ffd267"></path>
    </svg>
    <span class="sb-label">
      <small>{t('badges.getItOn')}</small>
      <strong>{t('badges.googlePlay')}</strong>
    </span>
  </a>
</div>
