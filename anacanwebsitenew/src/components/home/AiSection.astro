---
import { pagePath } from '@/config/pages';
import { useTranslations } from '@/i18n';

interface Props {
  lang: string;
  /** Hide CTA when embedded on the AI page itself */
  showCta?: boolean;
}

const { lang, showCta = true } = Astro.props;
const t = useTranslations(lang);
const bullets = t<string[]>('ai.bullets');
---

<section class="section" id="ai">
  <div class="container">
    <div class="ai-section reveal">
      <div class="ai-grid">
        <div>
          <span class="eyebrow">{t('ai.eyebrow')}</span>
          <h2 class="mt-2">{t('ai.title')}</h2>
          <p class="lede mt-2">{t('ai.subtitle')}</p>
          <ul class="ai-bullets mt-2">
            {bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
          {
            showCta && (
              <div class="mt-3">
                <a href={pagePath('ai', lang)} class="btn btn-primary">
                  {t('ai.cta')}
                </a>
              </div>
            )
          }
          <p class="ai-disclaimer mt-2">{t('ai.disclaimer')}</p>
        </div>

        <div class="chat-mock" aria-hidden="true">
          <div class="chat-head">
            <span class="chat-avatar">A</span>
            <div>
              <b>{t('ai.eyebrow')}</b>
              <span class="status">{t('ai.chat.online')}</span>
            </div>
          </div>
          <div class="bubble user">{t('ai.chat.userQ1')}</div>
          <div class="bubble ai">{t('ai.chat.aiA1')}</div>
          <div class="bubble user">{t('ai.chat.userQ2')}</div>
          <div class="bubble ai">{t('ai.chat.aiA2')}</div>
          <div class="chat-input">
            {t('ai.chat.placeholder')}
            <span class="send">➤</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
