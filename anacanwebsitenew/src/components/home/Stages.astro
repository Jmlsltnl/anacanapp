---
import { pagePath, type PageKey } from '@/config/pages';
import { useTranslations } from '@/i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const stageDefs: { key: PageKey & ('flow' | 'bump' | 'mommy' | 'partner'); emoji: string }[] = [
  { key: 'flow', emoji: '🌷' },
  { key: 'bump', emoji: '🤰' },
  { key: 'mommy', emoji: '🍼' },
  { key: 'partner', emoji: '🤝' },
];

const stages = stageDefs.map(({ key, emoji }, i) => ({
  key,
  emoji,
  href: pagePath(key, lang),
  name: t(`stages.${key}.name`),
  label: t(`stages.${key}.label`),
  tagline: t(`stages.${key}.tagline`),
  desc: t(`stages.${key}.desc`),
  bullets: t<string[]>(`stages.${key}.bullets`),
  delay: i * 70,
}));
---

<section class="section" id="stages">
  <div class="container">
    <div class="section-head center reveal">
      <span class="eyebrow">{t('stages.eyebrow')}</span>
      <h2>{t('stages.title')}</h2>
      <p class="lede">{t('stages.subtitle')}</p>
    </div>

    <div class="stage-grid">
      {stages.map((s) => (
        <a href={s.href} class="stage-card reveal" data-stage={s.key} style={`transition-delay:${s.delay}ms`}>
          <span class="stage-emoji" aria-hidden="true">{s.emoji}</span>
          <span class="stage-name">
            <b>{s.name}</b>
            <span>{s.label}</span>
          </span>
          <span class="stage-tagline">{s.tagline}</span>
          <p class="stage-desc">{s.desc}</p>
          <ul>
            {s.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
          <span class="stage-more">{t('stages.more')}</span>
        </a>
      ))}
    </div>
  </div>
</section>
