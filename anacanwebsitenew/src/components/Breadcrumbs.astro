---
import type { BreadcrumbItem } from '@/utils/seo';

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  {
    items.map((item, i) => (
      <>
        {i > 0 && <span class="sep" aria-hidden="true">/</span>}
        {i < items.length - 1 ? <a href={item.path}>{item.name}</a> : <span aria-current="page">{item.name}</span>}
      </>
    ))
  }
</nav>
