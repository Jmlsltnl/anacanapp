---
import { Image } from 'astro:assets';
import logo from '@/assets/logo.png';
import { SITE } from '@/config/site';
import { LANGUAGES, langPrefix } from '@/config/languages';
import { pagePath, type PageKey } from '@/config/pages';
import { useTranslations } from '@/i18n';
import StoreBadges from '@/components/StoreBadges.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const productLinks: { key: PageKey; label: string }[] = [
  { key: 'features', label: t('nav.features') },
  { key: 'flow', label: t('stages.flow.label') },
  { key: 'bump', label: t('stages.bump.label') },
  { key: 'mommy', label: t('stages.mommy.label') },
  { key: 'partner', label: t('stages.partner.label') },
  { key: 'ai', label: t('nav.ai') },
  { key: 'premium', label: t('nav.premium') },
];

const companyLinks: { key: PageKey; label: string }[] = [
  { key: 'about', label: t('nav.about') },
  { key: 'contact', label: t('nav.contact') },
  { key: 'download', label: t('footer.downloadTitle') },
];

const resourceLinks: { key: PageKey; label: string }[] = [
  { key: 'blog', label: t('nav.blog') },
  { key: 'ovulation', label: t('ovulationPage.title') },
  { key: 'symptoms', label: t('symptomsPage.title') },
  { key: 'competitors', label: t('compare.hubTitle') },
  { key: 'faq', label: t('nav.faq') },
];

const legalLinks: { key: PageKey; label: string }[] = [
  { key: 'privacy', label: t('legalPrivacy.title') },
  { key: 'terms', label: t('legalTerms.title') },
];

const rssHref = `${langPrefix(lang)}/rss.xml`;
const socials = Object.entries(SITE.socials).filter(([, url]) => Boolean(url));
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href={pagePath('home', lang)} class="brand" aria-label={SITE.name}>
          <Image src={logo} alt="" width={76} height={76} />
          <span>Anacan</span>
        </a>
        <p>{t('footer.description')}</p>
        <StoreBadges lang={lang} />
        {
          socials.length > 0 && (
            <ul style="display:flex;gap:.8rem;margin-top:.4rem">
              {socials.map(([name, url]) => (
                <li>
                  <a href={url} rel="noopener" target="_blank" style="font-weight:700;text-transform:capitalize">
                    {name}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div class="footer-col">
        <h4>{t('footer.product')}</h4>
        <ul>
          {productLinks.map((l) => (
            <li>
              <a href={pagePath(l.key, lang)}>{l.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h4>{t('footer.resources')}</h4>
        <ul>
          {resourceLinks.map((l) => (
            <li>
              <a href={pagePath(l.key, lang)}>{l.label}</a>
            </li>
          ))}
          <li><a href={rssHref}>{t('footer.rss')}</a></li>
        </ul>
        <h4 class="mt-3">{t('footer.legal')}</h4>
        <ul>
          {legalLinks.map((l) => (
            <li>
              <a href={pagePath(l.key, lang)}>{l.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h4>{t('footer.company')}</h4>
        <ul>
          {companyLinks.map((l) => (
            <li>
              <a href={pagePath(l.key, lang)}>{l.label}</a>
            </li>
          ))}
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        </ul>
      </div>
    </div>

    <nav class="footer-langs" aria-label={t('footer.language')}>
      {LANGUAGES.map((l) => (
        <a
          href={pagePath('home', l.code)}
          aria-current={l.code === lang ? 'true' : undefined}
          lang={l.code}
          hreflang={l.code}
        >
          {l.flag} {l.nativeName}
        </a>
      ))}
    </nav>

    <div class="footer-bottom">
      <span>© {year} {SITE.legalName}. {t('footer.copyright')}</span>
      <span>{t('footer.madeWith')}</span>
    </div>
  </div>
</footer>
