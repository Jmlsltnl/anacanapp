---
interface Props {
  items: { q: string; a: string }[];
  /** Open the first item by default */
  openFirst?: boolean;
}

const { items, openFirst = true } = Astro.props;
---

<div class="faq-list">
  {items.map((item, i) => (
    <details class="faq-item reveal" open={openFirst && i === 0} style={`transition-delay:${i * 40}ms`}>
      <summary>
        {item.q}
        <span class="plus" aria-hidden="true">+</span>
      </summary>
      <div class="faq-body">
        <p>{item.a}</p>
      </div>
    </details>
  ))}
</div>
